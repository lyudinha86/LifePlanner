@model LifePlanner.Data.Entities.PlannerEvent

@{
    ViewData["Title"] = "Eliminar Evento";
}

<div class="container mt-4">

    <h2>Eliminar Evento</h2>

    <div class="alert alert-warning mt-4">
        Tem a certeza de que pretende eliminar este evento?
    </div>

    <div class="card">
        <div class="card-body">

            <h4 class="card-title">
                @Model.Title
            </h4>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-muted">
                    @Model.Description
                </p>
            }

            <dl class="row mt-4">

                <dt class="col-sm-3">
                    Data de início
                </dt>

                <dd class="col-sm-9">
                    @Model.StartDate.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-3">
                    Data de fim
                </dt>

                <dd class="col-sm-9">
                    @if (Model.EndDate.HasValue)
                    {
                        @Model.EndDate.Value.ToString("dd/MM/yyyy HH:mm")
                    }
                    else
                    {
                        <span class="text-muted">
                            Sem data de fim
                        </span>
                    }
                </dd>

                <dt class="col-sm-3">
                    Local
                </dt>

                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        @Model.Location
                    }
                    else
                    {
                        <span class="text-muted">
                            Sem local
                        </span>
                    }
                </dd>

            </dl>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Eliminar
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>
    </div>
</div>
