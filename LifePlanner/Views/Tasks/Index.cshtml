@model IEnumerable<LifePlanner.Data.Entities.TaskItem>

@{
    ViewData["Title"] = "Tarefas";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Tarefas</h2>
            <p class="text-muted">
                Organize e acompanhe as suas tarefas.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Nova Tarefa
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Ainda não existem tarefas registadas.
        </div>
    }
    else
    {
        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Tarefa</th>
                    <th>Objetivo</th>
                    <th>Tags</th>
                    <th>Data limite</th>
                    <th>Prioridade</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <!-- TAREFA -->
                        <td>
                            <strong>@item.Title</strong>

                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div class="text-muted small">
                                    @item.Description
                                </div>
                            }
                        </td>

                        <!-- OBJETIVO -->
                        <td>
                            @if (item.Goal != null)
                            {
                                <span>
                                    @item.Goal.Title
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Sem objetivo
                                </span>
                            }
                        </td>

                        <!-- TAGS -->
                        <td>
                            @if (item.TaskTags != null && item.TaskTags.Any())
                            {
                                @foreach (var taskTag in item.TaskTags)
                                {
                                    <span class="badge bg-secondary me-1 mb-1">
                                        @taskTag.Tag.Name
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    Sem tags
                                </span>
                            }
                        </td>

                        <!-- DATA LIMITE -->
                        <td>
                            @if (item.DueDate.HasValue)
                            {
                                @item.DueDate.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">
                                    Sem data
                                </span>
                            }
                        </td>

                        <!-- PRIORIDADE -->
                        <td>
                            @item.Priority
                        </td>

                        <!-- ESTADO -->
                        <td>
                            @item.Status
                        </td>

                        <!-- AÇÕES -->
                        <td class="text-end">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Editar
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Detalhes
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Eliminar
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>