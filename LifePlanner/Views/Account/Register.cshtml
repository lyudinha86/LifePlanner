@model LifePlanner.Models.ViewModels.RegisterNewUserViewModel

@{
    ViewData["Title"] = "Criar Conta";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2>Criar Conta</h2>

                    <p class="text-muted mb-4">
                        Crie a sua conta para utilizar o LifePlanner.
                    </p>

                    <form asp-action="Register" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="FirstName"
                                       class="form-label">
                                    Nome
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="LastName"
                                       class="form-label">
                                    Apelido
                                </label>

                                <input asp-for="LastName"
                                       class="form-control" />

                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Username"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Username"
                                   class="form-control"
                                   placeholder="exemplo@email.com" />

                            <span asp-validation-for="Username"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   class="form-control" />

                            <span asp-validation-for="Password"
                                  class="text-danger"></span>

                            <div class="form-text">
                                A password deve ter pelo menos 6 caracteres,
                                incluindo uma letra maiúscula, uma letra minúscula
                                e um número.
                            </div>

                        </div>

                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                                Confirmar password
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>

                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Criar conta
                        </button>

                    </form>

                    <hr />

                    <div class="text-center">

                        Já tem uma conta?

                        <a asp-action="Login">
                            Iniciar sessão
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
