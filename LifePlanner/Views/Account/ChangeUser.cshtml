@model LifePlanner.Models.ViewModels.ChangeUserViewModel

@{
    ViewData["Title"] = "Editar Perfil";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <h2>Editar Perfil</h2>

            <p class="text-muted">
                Atualize os seus dados pessoais.
            </p>

            <hr />

            @if (ViewBag.UserMessage != null)
            {
                <div class="alert alert-success">
                    @ViewBag.UserMessage
                </div>
            }

            <form asp-action="ChangeUser" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">

                    <label asp-for="FirstName"
                           class="form-label">
                        Nome
                    </label>

                    <input asp-for="FirstName"
                           class="form-control" />

                    <span asp-validation-for="FirstName"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="LastName"
                           class="form-label">
                        Apelido
                    </label>

                    <input asp-for="LastName"
                           class="form-control" />

                    <span asp-validation-for="LastName"
                          class="text-danger"></span>

                </div>

                <div class="mb-4">

                    <label asp-for="Username"
                           class="form-label">
                        Email
                    </label>

                    <input asp-for="Username"
                           class="form-control" />

                    <span asp-validation-for="Username"
                          class="text-danger"></span>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Guardar alterações
                </button>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
