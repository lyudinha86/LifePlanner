@model IEnumerable<LifePlanner.Data.Entities.FinancialTransaction>

@{
    ViewData["Title"] = "Finanças";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Finanças</h2>
            <p class="text-muted">
                Acompanhe as suas receitas e despesas.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Novo Movimento
        </a>
    </div>

    <div class="row mb-4">

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Total de receitas
                    </h6>

                    <h3>
                        @(((decimal)ViewBag.TotalReceitas).ToString("N2")) €
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Total de despesas
                    </h6>

                    <h3>
                        @(((decimal)ViewBag.TotalDespesas).ToString("N2")) €
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Saldo
                    </h6>

                    <h3>
                        @(((decimal)ViewBag.Saldo).ToString("N2")) €
                    </h3>
                </div>
            </div>
        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Ainda não existem movimentos financeiros registados.
        </div>
    }
    else
    {
        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Descrição</th>
                    <th>Tipo</th>
                    <th>Categoria</th>
                    <th>Data</th>
                    <th>Valor</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <strong>@item.Description</strong>
                        </td>

                        <td>
                            @item.Type
                        </td>

                        <td>
                            @if (!string.IsNullOrEmpty(item.Category))
                            {
                                @item.Category
                            }
                            else
                            {
                                <span class="text-muted">
                                    Sem categoria
                                </span>
                            }
                        </td>

                        <td>
                            @item.TransactionDate.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @item.Amount.ToString("N2") €
                        </td>

                        <td class="text-end">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Editar
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Detalhes
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Eliminar
                            </a>

                        </td>

                    </tr>
                }

            </tbody>
        </table>
    }

</div>
