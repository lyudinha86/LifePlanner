<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LifePlanner</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/LifePlanner.styles.css"
          asp-append-version="true" />
</head>

<body>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="lp-app">

        <!-- =====================================================
             SIDEBAR
             ===================================================== -->
        <aside class="lp-sidebar">

           @if (User.IsInRole("Admin"))
    {
        <a class="lp-logo"
           asp-controller="Admin"
           asp-action="Index">
    
            <span class="lp-logo-icon">◆</span>
            <span>LifePlanner</span>
        </a>
    }
    else
    {
    <a class="lp-logo"
       asp-controller="Home"
       asp-action="Index">

        <span class="lp-logo-icon">◆</span>
        <span>LifePlanner</span>
    </a>
    }

            <nav class="lp-sidebar-nav">

    @if (User.IsInRole("Admin"))
    {
        <a class="lp-menu-link"
           asp-controller="Admin"
           asp-action="Index">
            <span class="lp-menu-icon">⚙</span>
            <span>Administração</span>
        </a>
    }
    else
    {
        <a class="lp-menu-link"
           asp-controller="Home"
           asp-action="Index">
            <span class="lp-menu-icon">⌂</span>
            <span>Início</span>
        </a>

        <a class="lp-menu-link"
           asp-controller="Tasks"
           asp-action="Index">
            <span class="lp-menu-icon">✓</span>
            <span>Tarefas</span>
        </a>

        <a class="lp-menu-link"
           asp-controller="Calendar"
           asp-action="Index">
            <span class="lp-menu-icon">▣</span>
            <span>Calendário</span>
        </a>

        <a class="lp-menu-link"
           asp-controller="Goals"
           asp-action="Index">
            <span class="lp-menu-icon">◎</span>
            <span>Objetivos</span>
        </a>

        <a class="lp-menu-link"
           asp-controller="PlannerEvents"
           asp-action="Index">
            <span class="lp-menu-icon">◷</span>
            <span>Eventos</span>
        </a>

        <a class="lp-menu-link"
           asp-controller="FinancialTransactions"
           asp-action="Index">
            <span class="lp-menu-icon">€</span>
            <span>Finanças</span>
        </a>

        <a class="lp-menu-link"
           asp-controller="Tags"
           asp-action="Index">
            <span class="lp-menu-icon">#</span>
            <span>Tags</span>
        </a>
    }

</nav>

<div class="lp-sidebar-bottom">

    <a class="lp-menu-link"
       asp-controller="Account"
       asp-action="ChangeUser">
        <span class="lp-menu-icon">○</span>
        <span>Perfil</span>
    </a>

    <a class="lp-menu-link"
       asp-controller="Account"
       asp-action="ChangePassword">
        <span class="lp-menu-icon">⚙</span>
        <span>Alterar password</span>
    </a>

</div>

        </aside>


        <!-- =====================================================
             MAIN AREA
             ===================================================== -->
        <div class="lp-main">

            <!-- TOPBAR -->
            <header class="lp-topbar">

                <div class="lp-topbar-title">
                    LifePlanner
                </div>

                <div class="dropdown">

                    <a class="lp-user dropdown-toggle"
                       href="#"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">

                        <span class="lp-avatar">
                            @(User.Identity.Name?.Substring(0, 1).ToUpper())
                        </span>

                        <span class="lp-user-name">
                            @User.Identity.Name
                        </span>

                    </a>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Account"
                               asp-action="ChangeUser">
                                Editar perfil
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Account"
                               asp-action="ChangePassword">
                                Alterar password
                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider" />
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Account"
                               asp-action="Logout">
                                Terminar sessão
                            </a>
                        </li>

                    </ul>

                </div>

            </header>


            <!-- PAGE CONTENT -->
            <main class="lp-content">
                @RenderBody()
            </main>

        </div>

    </div>
}
else
{
    <!-- =====================================================
         NÃO AUTENTICADO
         ===================================================== -->

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom">

            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    LifePlanner
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#publicNavbar">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div id="publicNavbar"
                     class="collapse navbar-collapse">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-primary ms-sm-2"
                               asp-controller="Account"
                               asp-action="Register">
                                Criar conta
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>
}


<!-- =========================================================
     FOOTER
     ========================================================= -->

<footer class="lp-footer">
    © 2026 LifePlanner
</footer>


<!-- =========================================================
     SCRIPTS
     ========================================================= -->

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>