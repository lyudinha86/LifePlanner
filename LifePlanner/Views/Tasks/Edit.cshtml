@model LifePlanner.Models.ViewModels.TaskFormViewModel

@{
    ViewData["Title"] = "Editar Tarefa";
}

<div class="container mt-4">

    <h2>Editar Tarefa</h2>

    <p class="text-muted">
        Altere os dados da tarefa.
    </p>

    <hr />

    <div class="row">
        <div class="col-md-7">

            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <input type="hidden" asp-for="Id" />


                <!-- TÍTULO -->
                <div class="mb-3">

                    <label asp-for="Title"
                           class="form-label">
                        Título
                    </label>

                    <input asp-for="Title"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>

                </div>


                <!-- DESCRIÇÃO -->
                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                        Descrição
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>

                </div>


                <!-- DATA LIMITE -->
                <div class="mb-3">

                    <label asp-for="DueDate"
                           class="form-label">
                        Data limite
                    </label>

                    <input asp-for="DueDate"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="DueDate"
                          class="text-danger"></span>

                </div>


                <!-- OBJETIVO -->
                <div class="mb-3">

                    <label asp-for="GoalId"
                           class="form-label">
                        Objetivo
                    </label>

                    <select asp-for="GoalId"
                            asp-items="Model.Goals"
                            class="form-select">

                        <option value="">
                            Sem objetivo
                        </option>

                    </select>

                </div>


                <!-- PRIORIDADE -->
                <div class="mb-3">

                    <label asp-for="Priority"
                           class="form-label">
                        Prioridade
                    </label>

                    <select asp-for="Priority"
                            class="form-select">

                        <option value="">
                            Selecione...
                        </option>

                        <option value="Baixa">
                            Baixa
                        </option>

                        <option value="Média">
                            Média
                        </option>

                        <option value="Alta">
                            Alta
                        </option>

                    </select>

                    <span asp-validation-for="Priority"
                          class="text-danger"></span>

                </div>


                <!-- ESTADO -->
                <div class="mb-3">

                    <label asp-for="Status"
                           class="form-label">
                        Estado
                    </label>

                    <select asp-for="Status"
                            class="form-select">

                        <option value="">
                            Selecione...
                        </option>

                        <option value="Pendente">
                            Pendente
                        </option>

                        <option value="Em progresso">
                            Em progresso
                        </option>

                        <option value="Concluída">
                            Concluída
                        </option>

                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger"></span>

                </div>


                <!-- TAGS -->
                <div class="mb-4">

                    <label class="form-label">
                        Tags
                    </label>

                    @if (Model.Tags.Any())
                    {
                        <div class="border rounded p-3">

                            @foreach (var tag in Model.Tags)
                            {
                                <div class="form-check">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="SelectedTagIds"
                                           value="@tag.Id"
                                           id="tag_@tag.Id"
                                           checked="@Model.SelectedTagIds.Contains(tag.Id)" />

                                    <label class="form-check-label"
                                           for="tag_@tag.Id">

                                        @tag.Name

                                    </label>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            Ainda não existem tags.
                        </div>
                    }

                </div>


                <button type="submit"
                        class="btn btn-primary">
                    Guardar alterações
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}