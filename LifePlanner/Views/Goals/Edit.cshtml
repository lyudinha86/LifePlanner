@model LifePlanner.Data.Entities.Goal

@{
    ViewData["Title"] = "Editar Objetivo";
}

<div class="container mt-4">

    <h2>Editar Objetivo</h2>
    <p class="text-muted">Altere os dados do objetivo.</p>

    <hr />

    <div class="row">
        <div class="col-md-6">

            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="StartDate" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">
                        Título
                    </label>

                    <input asp-for="Title"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Descrição
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DueDate" class="form-label">
                        Data limite
                    </label>

                    <input asp-for="DueDate"
                           type="date"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label">
                        Estado
                    </label>

                    <select asp-for="Status" class="form-select">
                        <option value="Em progresso">Em progresso</option>
                        <option value="Concluído">Concluído</option>
                        <option value="Cancelado">Cancelado</option>
                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Guardar alterações
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
