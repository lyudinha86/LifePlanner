@model IEnumerable<LifePlanner.Data.Entities.PlannerEvent>

@{
    ViewData["Title"] = "Eventos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Eventos</h2>
            <p class="text-muted">
                Organize e acompanhe os seus eventos.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Novo Evento
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Ainda não existem eventos registados.
        </div>
    }
    else
    {
        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Evento</th>
                    <th>Início</th>
                    <th>Fim</th>
                    <th>Local</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <strong>@item.Title</strong>

                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div class="text-muted small">
                                    @item.Description
                                </div>
                            }
                        </td>

                        <td>
                            @item.StartDate.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @if (item.EndDate.HasValue)
                            {
                                @item.EndDate.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">
                                    Sem data
                                </span>
                            }
                        </td>

                        <td>
                            @if (!string.IsNullOrEmpty(item.Location))
                            {
                                @item.Location
                            }
                            else
                            {
                                <span class="text-muted">
                                    Sem local
                                </span>
                            }
                        </td>

                        <td class="text-end">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Editar
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Detalhes
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Eliminar
                            </a>

                        </td>

                    </tr>
                }

            </tbody>
        </table>
    }

</div>
