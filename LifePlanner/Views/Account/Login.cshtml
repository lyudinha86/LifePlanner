@model LifePlanner.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="mb-2">Login</h2>

                    <p class="text-muted mb-4">
                        Inicie sessão na sua conta LifePlanner.
                    </p>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }
                    <form asp-action="Login" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">

                            <label asp-for="Username"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Username"
                                   class="form-control"
                                   placeholder="exemplo@email.com" />

                            <span asp-validation-for="Username"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   class="form-control" />

                            <span asp-validation-for="Password"
                                  class="text-danger"></span>

                        </div>

                        <div class="form-check mb-3">

                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label">
                                Lembrar-me
                            </label>

                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Entrar
                        </button>

                        <div class="text-center mt-3">
                            <a asp-controller="Account"
                               asp-action="RecoverPassword">
                                Esqueceu-se da password?
                            </a>
                        </div>

                    </form>

                    <hr />

                    <div class="text-center">

                        <p class="mb-2">
                            Ainda não tem conta?
                        </p>

                        <a asp-action="Register">
                            Criar conta
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
