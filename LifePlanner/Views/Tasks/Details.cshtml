@model LifePlanner.Data.Entities.TaskItem

@{
    ViewData["Title"] = "Detalhes da Tarefa";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Detalhes da Tarefa</h2>
            <p class="text-muted">
                Informação detalhada da tarefa.
            </p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">

            <h4 class="card-title mb-4">
                @Model.Title
            </h4>

            <dl class="row">

                <dt class="col-sm-3">
                    Descrição
                </dt>

                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        @Model.Description
                    }
                    else
                    {
                        <span class="text-muted">
                            Sem descrição
                        </span>
                    }
                </dd>

                <dt class="col-sm-3">
                    Data de criação
                </dt>

                <dd class="col-sm-9">
                    @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-3">
                    Data limite
                </dt>

                <dd class="col-sm-9">
                    @if (Model.DueDate.HasValue)
                    {
                        @Model.DueDate.Value.ToString("dd/MM/yyyy")
                    }
                    else
                    {
                        <span class="text-muted">
                            Sem data limite
                        </span>
                    }
                </dd>

                <dt class="col-sm-3">
                    Objetivo
                </dt>

                <dd class="col-sm-9">
                    @if (Model.Goal != null)
                    {
                        @Model.Goal.Title
                    }
                    else
                    {
                        <span class="text-muted">
                            Sem objetivo
                        </span>
                    }
                </dd>

                <dt class="col-sm-3">
                    Prioridade
                </dt>

                <dd class="col-sm-9">
                    @Model.Priority
                </dd>

                <dt class="col-sm-3">
                    Estado
                </dt>

                <dd class="col-sm-9">
                    @Model.Status
                </dd>

            </dl>

            <hr />

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Editar
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Voltar
            </a>

        </div>
    </div>

</div>