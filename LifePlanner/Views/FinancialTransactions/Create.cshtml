@model LifePlanner.Data.Entities.FinancialTransaction

@{
    ViewData["Title"] = "Novo Movimento";
}

<div class="container mt-4">

    <h2>Novo Movimento</h2>

    <p class="text-muted">
        Registe uma receita ou despesa.
    </p>

    <hr />

    <div class="row">
        <div class="col-md-6">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label">
                        Descrição
                    </label>

                    <input asp-for="Description"
                           class="form-control" />

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Type"
                           class="form-label">
                        Tipo
                    </label>

                    <select asp-for="Type"
                            class="form-select">

                        <option value="">
                            Selecione...
                        </option>

                        <option value="Receita">
                            Receita
                        </option>

                        <option value="Despesa">
                            Despesa
                        </option>

                    </select>

                    <span asp-validation-for="Type"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Amount"
                           class="form-label">
                        Valor
                    </label>

                    <input asp-for="Amount"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control" />

                    <span asp-validation-for="Amount"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TransactionDate"
                           class="form-label">
                        Data
                    </label>

                    <input asp-for="TransactionDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="TransactionDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category"
                           class="form-label">
                        Categoria
                    </label>

                    <input asp-for="Category"
                           class="form-control"
                           placeholder="Ex.: Alimentação, Trabalho, Transporte" />

                    <span asp-validation-for="Category"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Guardar
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
