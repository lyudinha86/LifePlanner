@model LifePlanner.Data.Entities.FinancialTransaction

@{
    ViewData["Title"] = "Editar Movimento";
}

<div class="container mt-4">

    <h2>Editar Movimento</h2>
    <p class="text-muted">
        Altere os dados do movimento financeiro.
    </p>

    <hr />

    <div class="row">
        <div class="col-md-6">

            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label">
                        Descrição
                    </label>

                    <input asp-for="Description"
                           class="form-control" />

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Type"
                           class="form-label">
                        Tipo
                    </label>

                    <select asp-for="Type"
                            class="form-select">

                        <option value="Receita">Receita</option>
                        <option value="Despesa">Despesa</option>

                    </select>

                    <span asp-validation-for="Type"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Amount"
                           class="form-label">
                        Valor
                    </label>

                    <input asp-for="Amount"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control" />

                    <span asp-validation-for="Amount"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TransactionDate"
                           class="form-label">
                        Data
                    </label>

                    <input asp-for="TransactionDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="TransactionDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category"
                           class="form-label">
                        Categoria
                    </label>

                    <input asp-for="Category"
                           class="form-control" />

                    <span asp-validation-for="Category"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Estado do pagamento</label>

                    <select asp-for="IsPaid"
                            id="paymentStatus"
                            class="form-select">
                        <option value="true">Pago</option>
                        <option value="false">Por pagar</option>
                    </select>

                    <span asp-validation-for="IsPaid"
                          class="text-danger"></span>
                </div>

                <div class="mb-3"
                     id="dueDateContainer">

                    <label asp-for="DueDate"
                           class="form-label">
                        Data de vencimento
                    </label>

                    <input asp-for="DueDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="DueDate"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Guardar alterações
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const paymentStatus =
                document.getElementById("paymentStatus");

            const dueDateContainer =
                document.getElementById("dueDateContainer");

            function updateDueDateVisibility() {

                if (paymentStatus.value === "false") {
                    dueDateContainer.style.display = "block";
                }
                else {
                    dueDateContainer.style.display = "none";
                }
            }

            paymentStatus.addEventListener(
                "change",
                updateDueDateVisibility
            );

            updateDueDateVisibility();
        });
    </script>
}
