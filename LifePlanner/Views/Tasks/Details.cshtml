@model LifePlanner.Data.Entities.TaskItem

@{
    ViewData["Title"] = "Detalhes da Tarefa";
}

<div class="container mt-4">

    <h2>Detalhes da Tarefa</h2>

    <p class="text-muted">
        Consulte toda a informação da tarefa.
    </p>

    <div class="card mt-4">
        <div class="card-body">

            <h4 class="card-title mb-4">
                @Model.Title
            </h4>

            <dl class="row">

                <dt class="col-sm-3">
                    Descrição
                </dt>

                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        @Model.Description
                    }
                    else
                    {
                        <span class="text-muted">
                            Sem descrição
                        </span>
                    }
                </dd>


                <dt class="col-sm-3">
                    Data de criação
                </dt>

                <dd class="col-sm-9">
                    @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                </dd>


                <dt class="col-sm-3">
                    Data limite
                </dt>

                <dd class="col-sm-9">
                    @if (Model.DueDate.HasValue)
                    {
                        @Model.DueDate.Value.ToString("dd/MM/yyyy HH:mm")
                    }
                    else
                    {
                        <span class="text-muted">
                            Sem data limite
                        </span>
                    }
                </dd>


                <dt class="col-sm-3">
                    Objetivo
                </dt>

                <dd class="col-sm-9">
                    @if (Model.Goal != null)
                    {
                        <a asp-controller="Goals"
                           asp-action="Details"
                           asp-route-id="@Model.Goal.Id">
                            @Model.Goal.Title
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">
                            Sem objetivo
                        </span>
                    }
                </dd>


                <dt class="col-sm-3">
                    Tags
                </dt>

                <dd class="col-sm-9">

                    @if (Model.TaskTags != null &&
                         Model.TaskTags.Any())
                    {
                        @foreach (var taskTag in Model.TaskTags
                            .OrderBy(tt => tt.Tag.Name))
                        {
                            <span class="badge bg-secondary me-1">
                                @taskTag.Tag.Name
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">
                            Sem tags
                        </span>
                    }

                </dd>


                <dt class="col-sm-3">
                    Prioridade
                </dt>

                <dd class="col-sm-9">
                    @Model.Priority
                </dd>


                <dt class="col-sm-3">
                    Estado
                </dt>

                <dd class="col-sm-9">
                    @Model.Status
                </dd>

            </dl>

            <hr />

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Editar
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Voltar
            </a>

        </div>
    </div>

</div>